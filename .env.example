# Neon pooled PostgreSQL URL. It must include "-pooler" in the hostname.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler/DB?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required only when running `npm run db:seed` after Phase 1 migrations.
ADMIN_EMAIL="gauravkr@iitbhilai.ac.in"
ADMIN_NAME="BattlePlay Admin"

# Optional during local Phase 0 development; required for Upstash-backed limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
